# Configurações do Supabase para o NutriSmart
# Obtenha estas credenciais no painel do Supabase: Project Settings -> API

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-publica-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui (apenas para Edge Function deploy)
