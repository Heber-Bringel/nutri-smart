{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nutri-smart-kappa.vercel.app/contracts/schemas.json",
  "title": "NutriSmart — Contratos de dados",
  "description": "Payloads compartilhados entre casos de uso, adapters e persistência. UUIDs e datas devem ser validados antes da persistência.",
  "$defs": {
    "Uuid": { "type": "string", "format": "uuid" },
    "Data": { "type": "string", "format": "date" },
    "DateTime": { "type": "string", "format": "date-time" },
    "LoginRequest": { "type": "object", "additionalProperties": false, "required": ["email", "senha"], "properties": { "email": { "type": "string", "format": "email" }, "senha": { "type": "string", "minLength": 8 } } },
    "AuthSession": { "type": "object", "additionalProperties": false, "required": ["access_token", "refresh_token", "expires_at"], "properties": { "access_token": { "type": "string", "minLength": 1 }, "refresh_token": { "type": "string", "minLength": 1 }, "expires_at": { "type": "integer", "minimum": 0 } } },
    "PacienteInput": { "type": "object", "additionalProperties": false, "required": ["nome_completo", "data_nascimento", "sexo_biologico", "peso_kg", "altura_cm", "nivel_atividade"], "properties": { "nome_completo": { "type": "string", "minLength": 2, "maxLength": 150 }, "data_nascimento": { "$ref": "#/$defs/Data" }, "sexo_biologico": { "type": "string", "enum": ["masculino", "feminino"] }, "peso_kg": { "type": "number", "exclusiveMinimum": 0, "maximum": 500 }, "altura_cm": { "type": "number", "exclusiveMinimum": 0, "maximum": 300 }, "nivel_atividade": { "type": "string", "enum": ["sedentario", "levemente_ativo", "moderadamente_ativo", "muito_ativo", "extremamente_ativo"] } } },
    "Paciente": { "allOf": [ { "$ref": "#/$defs/PacienteInput" }, { "type": "object", "required": ["id", "nutricionista_id", "created_at"], "properties": { "id": { "$ref": "#/$defs/Uuid" }, "nutricionista_id": { "$ref": "#/$defs/Uuid" }, "created_at": { "$ref": "#/$defs/DateTime" }, "imc": { "type": "number", "minimum": 0 }, "tmb": { "type": "number", "minimum": 0 }, "get": { "type": "number", "minimum": 0 } } } ] },
    "Alimento": { "type": "object", "additionalProperties": false, "required": ["nome", "quantidade", "unidade", "calorias"], "properties": { "nome": { "type": "string", "minLength": 1, "maxLength": 120 }, "quantidade": { "type": "number", "exclusiveMinimum": 0 }, "unidade": { "type": "string", "enum": ["g", "ml", "unidade"] }, "calorias": { "type": "number", "minimum": 0 } } },
    "Refeicao": { "type": "object", "additionalProperties": false, "required": ["nome", "ordem", "alimentos"], "properties": { "nome": { "type": "string", "minLength": 1, "maxLength": 80 }, "ordem": { "type": "integer", "minimum": 0 }, "alimentos": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Alimento" } } } },
    "PlanoAlimentarInput": { "type": "object", "additionalProperties": false, "required": ["paciente_id", "data_inicio", "refeicoes"], "properties": { "paciente_id": { "$ref": "#/$defs/Uuid" }, "data_inicio": { "$ref": "#/$defs/Data" }, "refeicoes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Refeicao" } } } },
    "PlanoAlimentar": { "allOf": [ { "$ref": "#/$defs/PlanoAlimentarInput" }, { "type": "object", "required": ["id", "nutricionista_id", "created_at"], "properties": { "id": { "$ref": "#/$defs/Uuid" }, "nutricionista_id": { "$ref": "#/$defs/Uuid" }, "created_at": { "$ref": "#/$defs/DateTime" } } } ] },
    "AdesaoInput": { "type": "object", "additionalProperties": false, "required": ["paciente_id", "refeicao_id", "data", "concluida"], "properties": { "paciente_id": { "$ref": "#/$defs/Uuid" }, "refeicao_id": { "$ref": "#/$defs/Uuid" }, "data": { "$ref": "#/$defs/Data" }, "concluida": { "type": "boolean" } } },
    "Adesao": { "allOf": [ { "$ref": "#/$defs/AdesaoInput" }, { "type": "object", "required": ["id", "created_at"], "properties": { "id": { "$ref": "#/$defs/Uuid" }, "created_at": { "$ref": "#/$defs/DateTime" } } } ] },
    "MedidaCorporalInput": { "type": "object", "additionalProperties": false, "required": ["paciente_id", "data_avaliacao"], "properties": { "paciente_id": { "$ref": "#/$defs/Uuid" }, "data_avaliacao": { "$ref": "#/$defs/Data" }, "cintura_cm": { "type": ["number", "null"], "minimum": 0 }, "quadril_cm": { "type": ["number", "null"], "minimum": 0 }, "braco_cm": { "type": ["number", "null"], "minimum": 0 }, "coxa_cm": { "type": ["number", "null"], "minimum": 0 }, "percentual_gordura": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }, "dobras_cutaneas_mm": { "type": ["number", "null"], "minimum": 0 } } },
    "MedidaCorporal": { "allOf": [ { "$ref": "#/$defs/MedidaCorporalInput" }, { "type": "object", "required": ["id", "nutricionista_id", "created_at"], "properties": { "id": { "$ref": "#/$defs/Uuid" }, "nutricionista_id": { "$ref": "#/$defs/Uuid" }, "created_at": { "$ref": "#/$defs/DateTime" } } } ] },
    "AnotacaoClinicaInput": { "type": "object", "additionalProperties": false, "required": ["paciente_id", "conteudo", "data_atendimento"], "properties": { "paciente_id": { "$ref": "#/$defs/Uuid" }, "conteudo": { "type": "string", "minLength": 1, "maxLength": 10000 }, "data_atendimento": { "$ref": "#/$defs/Data" } } },
    "AnotacaoClinica": { "allOf": [ { "$ref": "#/$defs/AnotacaoClinicaInput" }, { "type": "object", "required": ["id", "nutricionista_id", "created_at"], "properties": { "id": { "$ref": "#/$defs/Uuid" }, "nutricionista_id": { "$ref": "#/$defs/Uuid" }, "created_at": { "$ref": "#/$defs/DateTime" } } } ] },
    "ConsultaInput": { "type": "object", "additionalProperties": false, "required": ["paciente_id", "inicio", "duracao_minutos"], "properties": { "paciente_id": { "$ref": "#/$defs/Uuid" }, "inicio": { "$ref": "#/$defs/DateTime" }, "duracao_minutos": { "type": "integer", "minimum": 15, "maximum": 480 }, "observacoes": { "type": ["string", "null"], "maxLength": 2000 } } },
    "Consulta": { "allOf": [ { "$ref": "#/$defs/ConsultaInput" }, { "type": "object", "required": ["id", "nutricionista_id", "status", "created_at"], "properties": { "id": { "$ref": "#/$defs/Uuid" }, "nutricionista_id": { "$ref": "#/$defs/Uuid" }, "status": { "type": "string", "enum": ["agendada", "cancelada", "realizada"] }, "created_at": { "$ref": "#/$defs/DateTime" } } } ] }
  }
}
